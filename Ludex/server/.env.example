# server/.env.example - plantilla (NO subir credenciales reales aquí)
DB_SERVER=127.0.0.1         # o DESKTOP-QHJKRMF\\SQLEXPRESS (ver nota abajo)
DB_NAME=TuNombreBD
DB_PORT=1433

# SQL Authentication (rellena en .env si usas usuario/clave)
DB_USER=sa
DB_PASSWORD=TuPasswordSegura
PORT=3000
# Windows Auth: poner true para usar autenticación integrada
USE_WINDOWS_AUTH=false
